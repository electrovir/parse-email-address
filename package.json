{
    "name": "parse-email-address",
    "version": "0.0.4",
    "description": "Parse/validate email addresses with RFC-5321, and message header address lists with RFC-5322.",
    "keywords": [
        "smtp-address-parser",
        "smtp",
        "email",
        "address",
        "address-list",
        "header",
        "mailbox",
        "parser",
        "validator",
        "validate",
        "normalize",
        "rfc821",
        "rfc2821",
        "rfc2822",
        "rfc5321",
        "rfc5322",
        "rfc6531"
    ],
    "homepage": "https://github.com/electrovir/parse-email-address",
    "bugs": {
        "url": "https://github.com/electrovir/parse-email-address/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/parse-email-address.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "virmator frontend build",
        "compile": "npm run compile:grammar && virmator compile",
        "compile:grammar": "nearleyc src/grammar.ne -o src/grammar.ts && tsx scripts/prepend-comment.script.ts",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "virmator frontend",
        "test": "virmator test web",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm test update"
    },
    "overrides": {
        "playwright": "1.61.1"
    },
    "devDependencies": {
        "@augment-vir/assert": "^32.1.0",
        "@augment-vir/test": "^32.1.0",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.64.0",
        "@web/dev-server-esbuild": "^2.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-commands": "^1.0.1",
        "@web/test-runner-playwright": "^1.0.0",
        "@web/test-runner-visual-regression": "^1.0.1",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.2.0",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "nearley": "^2.20.1",
        "npm-check-updates": "^22.2.9",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "type-fest": "^5.8.0",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "virmator": "^14.28.1"
    },
    "engines": {
        "node": ">=22"
    }
}
